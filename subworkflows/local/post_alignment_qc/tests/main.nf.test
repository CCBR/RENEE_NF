nextflow_workflow {

    name "Test Subworkflow POST_ALIGNMENT_QC"
    script "../main.nf"
    workflow "POST_ALIGNMENT_QC"

    tag "subworkflows"
    tag "subworkflows/post_alignment_qc"
    tag "qc"

    test("sarscov2 - paired_end - bam - stub") {
        config "./nextflow.config"
        options "-stub"

        when {
            workflow {
                """
                input[0] = Channel.of([
                    [ id:'test', single_end:false ],
                    file(params.test_data['sarscov2']['illumina'].test_paired_end_sorted_bam, checkIfExists: true)
                ])
                input[1] = Channel.of([
                    [ id:'test', single_end:false ],
                    file(params.test_data['sarscov2']['illumina'].test_paired_end_sorted_bam_bai, checkIfExists: true)
                ])
                input[2] = Channel.value(file("${projectDir}/tests/test_data/hg38_stub/genes.ref.bed", checkIfExists: true))
                input[3] = Channel.value(file("${projectDir}/tests/test_data/hg38_stub/transcripts.protein_coding_only.bed12", checkIfExists: true))
                input[4] = Channel.value(file("${projectDir}/tests/test_data/hg38_stub/refFlat.txt", checkIfExists: true))
                input[5] = Channel.value([
                    [ id:'hg38_stub' ],
                    file("${projectDir}/tests/test_data/hg38_stub/genome.fa", checkIfExists: true)
                ])
                input[6] = Channel.value(file("${projectDir}/tests/test_data/hg38_stub/hg38_stub.rRNA_interval_list", checkIfExists: true))
                input[7] = Channel.value([
                    [ id:'hg38_stub' ],
                    file("${projectDir}/tests/test_data/hg38_stub/genes.gtf", checkIfExists: true)
                ])
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.infer_experiment.size()       == 1 },
                { assert workflow.out.read_distribution.size()      == 1 },
                { assert workflow.out.inner_distance_freq.size()    == 1 },
                { assert workflow.out.inner_distance_dist.size()    == 1 },
                { assert workflow.out.inner_distance_rscript.size() == 1 },
                { assert workflow.out.tin_txt.size()                == 1 },
                { assert workflow.out.tin_xls.size()                == 1 },
                { assert workflow.out.preseq_ccurve.size()          == 1 },
                { assert workflow.out.preseq_log.size()             == 1 },
                { assert workflow.out.preseq_nrf.size()             == 1 },
                { assert workflow.out.picard_rna_metrics.size()     == 1 },
                { assert workflow.out.qualimap_results.size()       == 1 },
                { assert workflow.out.flagstat.size()               == 1 },
                { assert workflow.out.flagstat_versions.size()      == 1 }
            )
        }
    }

    test("sarscov2 - single_end - bam - stub") {
        config "./nextflow.config"
        options "-stub"

        when {
            workflow {
                """
                input[0] = Channel.of([
                    [ id:'test', single_end:true ],
                    file(params.test_data['sarscov2']['illumina'].test_single_end_sorted_bam, checkIfExists: true)
                ])
                input[1] = Channel.of([
                    [ id:'test', single_end:true ],
                    file(params.test_data['sarscov2']['illumina'].test_single_end_sorted_bam_bai, checkIfExists: true)
                ])
                input[2] = Channel.value(file("${projectDir}/tests/test_data/hg38_stub/genes.ref.bed", checkIfExists: true))
                input[3] = Channel.value(file("${projectDir}/tests/test_data/hg38_stub/transcripts.protein_coding_only.bed12", checkIfExists: true))
                input[4] = Channel.value(file("${projectDir}/tests/test_data/hg38_stub/refFlat.txt", checkIfExists: true))
                input[5] = Channel.value([
                    [ id:'hg38_stub' ],
                    file("${projectDir}/tests/test_data/hg38_stub/genome.fa", checkIfExists: true)
                ])
                input[6] = Channel.value(file("${projectDir}/tests/test_data/hg38_stub/hg38_stub.rRNA_interval_list", checkIfExists: true))
                input[7] = Channel.value([
                    [ id:'hg38_stub' ],
                    file("${projectDir}/tests/test_data/hg38_stub/genes.gtf", checkIfExists: true)
                ])
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.infer_experiment.size()       == 1 },
                { assert workflow.out.read_distribution.size()      == 1 },
                // inner_distance.py requires mate pairs, so it is skipped for single-end data
                { assert !workflow.out.inner_distance_freq },
                { assert !workflow.out.inner_distance_dist },
                { assert !workflow.out.inner_distance_rscript },
                { assert workflow.out.tin_txt.size()                == 1 },
                { assert workflow.out.tin_xls.size()                == 1 },
                { assert workflow.out.preseq_ccurve.size()          == 1 },
                { assert workflow.out.preseq_log.size()             == 1 },
                { assert workflow.out.preseq_nrf.size()             == 1 },
                { assert workflow.out.picard_rna_metrics.size()     == 1 },
                { assert workflow.out.qualimap_results.size()       == 1 },
                { assert workflow.out.flagstat.size()               == 1 },
                { assert workflow.out.flagstat_versions.size()      == 1 }
            )
        }
    }
}
