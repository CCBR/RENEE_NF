nextflow_workflow {

    name "Test Workflow prepare_genome_workflow"
    script "subworkflows/local/prepare_genome/main.nf"
    workflow "PREPARE_GENOME"

    test("fasta_gtf") {
        config "./nextflow.config"

        when {
            workflow {
                """
                input[0] = Channel.value([])
                """
            }
            params {
                // These are loaded before  test_data.config so the paths must be hard coded.
                genome         = null
                genome_fasta   = "https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/genome/genome.fasta"
                genes_gtf      = "https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/genome/genome.gtf"
                rename_contigs = null
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    file(workflow.out.star_index[0][1]).listFiles().collect { it.getName() }.sort().toString(),
                    workflow.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }
    }

    test("fasta_gtf_stub") {
        config "./nextflow.config"
        options '-stub'

        when {
            workflow {
                """
                input[0] = Channel.value([])
                """
            }
            params {
                genome         = null
                genome_fasta   = "https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/genome/genome.fasta"
                genes_gtf      = "https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/genome/genome.gtf"
                rename_contigs = null
            }
        }

        then {
            // rsem_ref is a `--reference` prefix *string* (see
            // subworkflows/local/prepare_genome/main.nf), not a Nextflow path,
            // so nf-test can't auto-normalize it to a stable filename:md5 the
            // way it does every other (path-typed) output here -- it would
            // otherwise snapshot the absolute, per-run work-dir path verbatim
            // and fail on every re-run. Keep just its basename instead, and
            // drop "12", the same value under its positional-index key.
            def out = workflow.out.findAll { key, val -> key != "12" } + [
                rsem_ref: [ new File(workflow.out.rsem_ref[0].toString()).getName() ]
            ]
            assertAll(
                { assert workflow.success },
                { assert snapshot(out).match() }
            )
        }
    }

}
