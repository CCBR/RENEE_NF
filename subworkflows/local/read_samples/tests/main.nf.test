nextflow_workflow {

    name "Test Subworkflow READ_SAMPLES"
    script "../main.nf"
    workflow "CHECK_INPUT"

    test("projectDir FASTQ paths resolve") {
        when {
            workflow {
                """
                input[0] = Channel.value(file("${projectDir}/assets/samplesheet_small.csv", checkIfExists: true))
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.reads[0][1].every { it.exists() } }
            )
        }
    }
}
