nextflow_workflow {

    name "Test Subworkflow arriba_workflow"
    script "../main.nf"
    workflow "arriba_workflow"

    tag "subworkflows"
    tag "subworkflows/arriba_workflow"
    tag "star/align"
    tag "arriba/arriba"
    tag "samtools/sort"
    tag "arriba/visualisation"

    test("arriba_workflow - homo_sapiens - paired_end - stub") {

        options "-stub"
        config "./nextflow.config"

        when {
            workflow {
                """
                // Paired-end trimmed reads
                input[0] = Channel.of([
                    [ id:'test', single_end:false ],
                    [
                        file(params.test_data['homo_sapiens']['illumina'].test_rnaseq_1_fastq_gz, checkIfExists: true),
                        file(params.test_data['homo_sapiens']['illumina'].test_rnaseq_2_fastq_gz, checkIfExists: true)
                    ]
                ])
                // STAR genome index — tuple [meta, dir]
                input[1] = Channel.of([
                    [ id:'genome' ],
                    file(params.test_data['homo_sapiens']['genome'].genome_fasta, checkIfExists: true)
                ])
                // Annotation GTF — tuple [meta, file]
                input[2] = Channel.of([
                    [ id:'genome' ],
                    file(params.test_data['homo_sapiens']['genome'].genome_gtf, checkIfExists: true)
                ])
                // Genome FASTA — bare path
                input[3] = Channel.value(
                    file(params.test_data['homo_sapiens']['genome'].genome_fasta, checkIfExists: true)
                )
                // Fusion blacklist — use sjdb_placeholder as a stand-in so the blacklist gate fires
                input[4] = Channel.value(
                    file("${projectDir}/assets/sjdb_placeholder.SJ.out.tab", checkIfExists: true)
                )
                // known_fusions, cytobands, protein_domains — all optional / absent
                input[5] = Channel.empty()
                input[6] = Channel.empty()
                input[7] = Channel.empty()
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match() }
            )
        }
    }
}
