includeConfig '../../../../conf/containers.config'

// Reuse ci_stub.config's database_urls map so this test fetches the same
// small local tar fixtures (tests/test_data/database_url_stubs/) that CI's
// stub build already exercises, instead of a second copy that can drift.
includeConfig '../../../../conf/ci_stub.config'

params {
    outputDir = 'output'
}

process {
    cpus   = 1
    memory = '1.GB'
}
