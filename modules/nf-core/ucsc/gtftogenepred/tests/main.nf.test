
nextflow_process {

    name "Test Process UCSC_GTFTOGENEPRED"
    script "../main.nf"
    process "UCSC_GTFTOGENEPRED"
    config "./nextflow.config"

    tag "modules"
    tag "modules_nfcore"
    tag "ucsc"
    tag "ucsc/gtftogenepred"

    test("test-ucsc-gtftogenepred") {

        when {
            process {
                """
                input[0] = [
                    [ id: 'test' ], // meta map
                    [ file(params.test_data['sarscov2']['genome'].genome_gtf, checkIfExists: true) ]
                ]

                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
    test("test-ucsc-gtftogenepred --stub") {
        options '-stub'
        when {
            process {
                """
                input[0] = [
                    [ id: 'test' ], // meta map
                    [ file(params.test_data['sarscov2']['genome'].genome_gtf, checkIfExists: true) ]
                ]

                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

}
