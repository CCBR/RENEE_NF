nextflow_process {

    name "Test Process QUALIMAP_BAMQC"
    script "../main.nf"
    process "QUALIMAP_BAMQC"
    config "./nextflow.config"
    tag "modules"
    tag "modules_nfcore"
    tag "qualimap"
    tag "qualimap/bamqc"

    test("sarscov2 - paired_end [bam] [gff]") {
        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'test', single_end:false ], // meta map
                    file(params.test_data['sarscov2']['illumina'].test_paired_end_sorted_bam, checkIfExists: true)
                ])
                input[1] = file(params.test_data['sarscov2']['genome'].genome_gtf, checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    file("${process.out.results[0][1]}/qualimapReport.html").name,
                    path("${process.out.results[0][1]}/genome_results.txt"),
                    process.out.findAll { key, val -> key.startsWith("versions") }
                ).match() }
            )
        }
    }

    test("sarscov2 - single_end [bam]") {
        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'test', single_end:true ], // meta map
                    file(params.test_data['sarscov2']['illumina'].test_single_end_sorted_bam, checkIfExists: true)
                ])
                input[1] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    file("${process.out.results[0][1]}/qualimapReport.html").name,
                    path("${process.out.results[0][1]}/genome_results.txt"),
                    process.out.findAll { key, val -> key.startsWith("versions") }
                ).match() }
            )
        }
    }

    test("sarscov2 - paired_end [bam] - stub") {
        options "-stub"
        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'test', single_end:false ], // meta map
                    file(params.test_data['sarscov2']['illumina'].test_paired_end_sorted_bam, checkIfExists: true)
                ])
                input[1] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
