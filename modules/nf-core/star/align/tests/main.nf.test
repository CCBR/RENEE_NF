nextflow_process {

    name "Test Process STAR_ALIGN"
    script "../main.nf"
    process "STAR_ALIGN"
    tag "modules"
    tag "modules_nfcore"
    tag "star"
    tag "star/align"



    test("homo_sapiens - paired_end - stub") {
        options "-stub"
        config "./nextflow.config"

        // Using pre-built genome index from run_test_config.sh for comparison with snakemake results
        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'test', single_end:false ], // meta map
                    [
                        file(params.test_data['snakemake_results']['trim'].wt_s1_r1_trim_fastq_gz, checkIfExists: true),
                        file(params.test_data['snakemake_results']['trim'].wt_s1_r1_trim_fastq_gz, checkIfExists: true)
                    ]
                ])
                input[1] = Channel.of([
                    [ id:'hg38_45' ],
                    [ file('/data/CCBR_Pipeliner/db/PipeDB/Indices/hg38_45/STAR/2.7.6a/genome', checkIfExists: true) ]
                ])
                input[2] = Channel.of([
                    [ id:'test_gtf' ],
                    [ file('/data/CCBR_Pipeliner/db/PipeDB/Indices/hg38_45/gencode.v45.primary_assembly.annotation.gtf', checkIfExists: true) ]
                ])
                input[3] = false
                input[4] = false
                input[5] = Channel.of([file("${projectDir}/assets/sjdb_placeholder.SJ.out.tab", checkIfExists: true)])
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("homo_sapiens - paired_end - stargenome") {
        config "./nextflow.config"

        // Non-stub test to compare _STARgenome output against snakemake reference results
        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'test', single_end:false ], // meta map
                    [
                        file(params.test_data['snakemake_results']['trim'].wt_s1_r1_trim_fastq_gz, checkIfExists: true),
                        file(params.test_data['snakemake_results']['trim'].wt_s1_r1_trim_fastq_gz, checkIfExists: true)
                    ]
                ])
                input[1] = Channel.of([
                    [ id:'hg38_45' ],
                    [ file('/data/CCBR_Pipeliner/db/PipeDB/Indices/hg38_45/STAR/2.7.6a/genome', checkIfExists: true) ]
                ])
                input[2] = Channel.of([
                    [ id:'test_gtf' ],
                    [ file('/data/CCBR_Pipeliner/db/PipeDB/Indices/hg38_45/gencode.v45.primary_assembly.annotation.gtf', checkIfExists: true) ]
                ])
                input[3] = false
                input[4] = false
                input[5] = Channel.of([file("${projectDir}/assets/sjdb_placeholder.SJ.out.tab", checkIfExists: true)])
                """
            }
        }

        then {
            def stargenomePath = process.out.stargenome[0][1].toString()
            def md5sum = { String f -> java.security.MessageDigest.getInstance("MD5").digest(new File(f).bytes).encodeHex().toString() }
            def ref = params.test_data['snakemake_results']['star']['wt_s1_stargenome']
            assertAll(
                { assert process.success },
                { assert md5sum("${stargenomePath}/exonGeTrInfo.tab")         == md5sum(ref.exongetrinfo_tab.toString()) },
                { assert md5sum("${stargenomePath}/exonInfo.tab")             == md5sum(ref.exoninfo_tab.toString()) },
                { assert md5sum("${stargenomePath}/geneInfo.tab")             == md5sum(ref.geneinfo_tab.toString()) },
                { assert md5sum("${stargenomePath}/sjdbInfo.txt")             == md5sum(ref.sjdbinfo_txt.toString()) },
                { assert md5sum("${stargenomePath}/sjdbList.fromGTF.out.tab") == md5sum(ref.sjdblist_fromgtf_out_tab.toString()) },
                { assert md5sum("${stargenomePath}/sjdbList.out.tab")         == md5sum(ref.sjdblist_out_tab.toString()) },
                { assert md5sum("${stargenomePath}/transcriptInfo.tab")       == md5sum(ref.transcriptinfo_tab.toString()) }
            )
        }
    }
}
