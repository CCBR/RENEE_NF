nextflow_process {

    name "Test Process RSEQC_INNERDISTANCE"
    script "../main.nf"
    process "RSEQC_INNERDISTANCE"
    config "./nextflow.config"

    tag "modules"
    tag "modules_nfcore"
    tag "rseqc"
    tag "rseqc/innerdistance"

    test("sarscov2 - [[meta] - bam] - bed") {

        when {
            process {
                """
                input[0] = channel.of([
                    [ id:'test', single_end: false ],
                    file(params.test_data['sarscov2']['illumina'].test_paired_end_sorted_bam, checkIfExists: true),
                    file(params.test_data['sarscov2']['illumina'].test_paired_end_sorted_bam_bai, checkIfExists: true)
                ])
                input[1] = channel.of(file(params.test_data['sarscov2']['genome'].test_bed12, checkIfExists: true))
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.pdf.size() > 0 ? file(process.out.pdf[0][1]).name : [],
                    process.out.distance,
                    process.out.freq,
                    process.out.mean,
                    process.out.rscript,
                    process.out.versions_rseqc
                ).match() }
            )
        }
    }

    test("sarscov2 - [[meta] - bam] - bed - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = channel.of([
                    [ id:'test', single_end: false ],
                    file(params.test_data['sarscov2']['illumina'].test_paired_end_sorted_bam, checkIfExists: true),
                    file(params.test_data['sarscov2']['illumina'].test_paired_end_sorted_bam_bai, checkIfExists: true)
                ])
                input[1] = channel.of(file(params.test_data['sarscov2']['genome'].test_bed, checkIfExists: true))
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
