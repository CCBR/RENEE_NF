nextflow_process {

    name "Test Process FUSION_ARRIBA"
    script "../main.nf"
    process "FUSION_ARRIBA"

    tag "modules"
    tag "modules_local"
    tag "fusion_arriba"

    test("homo_sapiens - paired_end - stub") {

        options "-stub"
        config "./nextflow.config"

        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'test', single_end:false ],
                    [
                        file("${projectDir}/tests/test_data/arriba/read.R1.fastq.gz", checkIfExists: true),
                        file("${projectDir}/tests/test_data/arriba/read.R2.fastq.gz", checkIfExists: true)
                    ]
                ])
                input[1] = Channel.of([
                    [ id:'genome' ],
                    file("${projectDir}/tests/test_data/hg38_stub/genome.fa", checkIfExists: true)
                ])
                input[2] = Channel.of([
                    [ id:'genome' ],
                    file("${projectDir}/tests/test_data/hg38_stub/genes.gtf", checkIfExists: true)
                ])
                input[3] = Channel.of([
                    [ id:'genome' ],
                    file("${projectDir}/tests/test_data/hg38_stub/star_index", checkIfExists: true)
                ])
                input[4] = file("${projectDir}/tests/test_data/hg38_stub/arriba_blacklist.tsv", checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.fusions[0][1] ==~ '.*/test.fusions.tsv' },
                { assert process.out.fusions_fail[0][1] ==~ '.*/test.fusions.discarded.tsv' },
                { assert process.out.bam[0][1] ==~ '.*/test.Aligned.out.bam' },
                { assert process.out.log_final[0][1] ==~ '.*/test.Log.final.out' },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("homo_sapiens - single_end - should fail") {

        options "-stub"
        config "./nextflow.config"

        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'test', single_end:true ],
                    [ file("${projectDir}/tests/test_data/arriba/read.R1.fastq.gz", checkIfExists: true) ]
                ])
                input[1] = Channel.of([
                    [ id:'genome' ],
                    file("${projectDir}/tests/test_data/hg38_stub/genome.fa", checkIfExists: true)
                ])
                input[2] = Channel.of([
                    [ id:'genome' ],
                    file("${projectDir}/tests/test_data/hg38_stub/genes.gtf", checkIfExists: true)
                ])
                input[3] = Channel.of([
                    [ id:'genome' ],
                    file("${projectDir}/tests/test_data/hg38_stub/star_index", checkIfExists: true)
                ])
                input[4] = file("${projectDir}/tests/test_data/hg38_stub/arriba_blacklist.tsv", checkIfExists: true)
                """
            }
        }

        then {
            assert process.failed
            assert process.errorReport.contains("FUSION_ARRIBA requires paired-end reads")
        }
    }

    // TODO: make a non-stub test that is capable of running on biowulf
    // The sarscov2 genome is not great for this

}
