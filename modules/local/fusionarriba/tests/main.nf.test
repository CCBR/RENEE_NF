nextflow_process {

    name "Test Process FUSIONARRIBA"
    script "../main.nf"
    process "FUSIONARRIBA"

    tag "modules"
    tag "modules_local"
    tag "fusionarriba"

    test("homo_sapiens - paired_end - stub") {

        options "-stub"
        config "./nextflow.config"

        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'test', single_end:false ],
                    [
                        file(params.test_data['homo_sapiens']['illumina'].test_rnaseq_1_fastq_gz, checkIfExists: true),
                        file(params.test_data['homo_sapiens']['illumina'].test_rnaseq_2_fastq_gz, checkIfExists: true)
                    ]
                ])
                input[1] = Channel.of([
                    [ id:'genome' ],
                    file(params.test_data['homo_sapiens']['genome'].genome_fasta, checkIfExists: true)
                ])
                input[2] = Channel.of([
                    [ id:'genome' ],
                    file(params.test_data['homo_sapiens']['genome'].genome_gtf, checkIfExists: true)
                ])
                input[3] = []
                input[4] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.fusions[0][1] ==~ '.*/test.fusions.tsv' },
                { assert process.out.fusions_fail[0][1] ==~ '.*/test.fusions.discarded.tsv' },
                { assert process.out.bam[0][1] ==~ '.*/test.Aligned.out.bam' },
                { assert process.out.log_final[0][1] ==~ '.*/test.Log.final.out' },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("homo_sapiens - single_end - should fail") {

        options "-stub"
        config "./nextflow.config"

        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'test', single_end:true ],
                    [ file(params.test_data['homo_sapiens']['illumina'].test_rnaseq_1_fastq_gz, checkIfExists: true) ]
                ])
                input[1] = Channel.of([
                    [ id:'genome' ],
                    file(params.test_data['homo_sapiens']['genome'].genome_fasta, checkIfExists: true)
                ])
                input[2] = Channel.of([
                    [ id:'genome' ],
                    file(params.test_data['homo_sapiens']['genome'].genome_gtf, checkIfExists: true)
                ])
                input[3] = []
                input[4] = []
                """
            }
        }

        then {
            assert process.failed
            assert process.errorReport.contains("FUSIONARRIBA requires paired-end reads")
        }
    }

    test("sarscov2 - paired_end") {

        config "./nextflow.config"

        setup {
            run("STAR_GENOMEGENERATE") {
                script "modules/nf-core/star/genomegenerate/main.nf"
                process {
                    """
                    input[0] = Channel.of([
                        [ id:'test_fasta' ],
                        [ file(params.test_data['sarscov2']['genome'].genome_fasta, checkIfExists: true) ]
                    ])
                    input[1] = Channel.of([
                        [ id:'test_gtf' ],
                        [ file(params.test_data['sarscov2']['genome'].genome_gtf, checkIfExists: true) ]
                    ])
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'test', single_end:false ],
                    [
                        file(params.test_data['sarscov2']['illumina'].test_1_fastq_gz, checkIfExists: true),
                        file(params.test_data['sarscov2']['illumina'].test_2_fastq_gz, checkIfExists: true)
                    ]
                ])
                input[1] = Channel.of([
                    [ id:'test_fasta' ],
                    [ file(params.test_data['sarscov2']['genome'].genome_fasta, checkIfExists: true) ]
                ])
                input[2] = Channel.of([
                    [ id:'test_gtf' ],
                    [ file(params.test_data['sarscov2']['genome'].genome_gtf, checkIfExists: true) ]
                ])
                input[3] = STAR_GENOMEGENERATE.out.index
                input[4] = file("${projectDir}/assets/sjdb_placeholder.SJ.out.tab", checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.fusions[0][1]).exists() },
                { assert path(process.out.fusions_fail[0][1]).exists() },
                { assert path(process.out.bam[0][1]).exists() },
                { assert path(process.out.log_final[0][1]).exists() },
                { assert snapshot(
                    file(process.out.fusions[0][1]).name,
                    file(process.out.fusions_fail[0][1]).name,
                    file(process.out.bam[0][1]).name,
                    file(process.out.log_final[0][1]).name,
                    process.out.versions_star,
                    process.out.versions_arriba
                ).match() }
            )
        }
    }

}
