nextflow_process {

    name "Test Process FASTQ_SCREEN"
    script "modules/local/fastq_screen/main.nf"
    process "FASTQ_SCREEN"

    test("sarscov2 paired-end [fastq]") {

        tag "integration"

        when {
            process {
                """
                input[0] = Channel.of([
                    [ id: 'test', single_end: false ],
                    [
                        file(params.test_data['sarscov2']['illumina'].test_1_fastq_gz, checkIfExists: true),
                        file(params.test_data['sarscov2']['illumina'].test_2_fastq_gz, checkIfExists: true)
                    ]
                ])
                input[1] = file(params.fastq_screen_conf, checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.txt[0][1][0] ==~ /.*\/test_1_screen\.txt/ },
                { assert process.out.txt[0][1][1] ==~ /.*\/test_2_screen\.txt/ },
                { assert process.out.png[0][1][0] ==~ /.*\/test_1_screen\.png/ },
                { assert process.out.png[0][1][1] ==~ /.*\/test_2_screen\.png/ }
            )
        }

    }

    test("sarscov2 single-end [fastq]") {

        tag "integration"

        when {
            process {
                """
                input[0] = Channel.of([
                    [ id: 'test', single_end: true ],
                    [
                        file(params.test_data['sarscov2']['illumina'].test_1_fastq_gz, checkIfExists: true)
                    ]
                ])
                input[1] = file(params.fastq_screen_conf, checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.txt[0][1] ==~ /.*\/test_1_screen\.txt/ },
                { assert process.out.png[0][1] ==~ /.*\/test_1_screen\.png/ }
            )
        }

    }

    test("sarscov2 paired-end [fastq] stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = Channel.of([
                    [ id: 'test', single_end: false ],
                    [
                        file(params.test_data['sarscov2']['illumina'].test_1_fastq_gz, checkIfExists: true),
                        file(params.test_data['sarscov2']['illumina'].test_2_fastq_gz, checkIfExists: true)
                    ]
                ])
                input[1] = file("${projectDir}/assets/fastq_screen_biowulf.conf", checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.txt[0][1][0] ==~ /.*\/test_1_screen\.txt/ },
                { assert process.out.txt[0][1][1] ==~ /.*\/test_2_screen\.txt/ },
                { assert process.out.png[0][1][0] ==~ /.*\/test_1_screen\.png/ },
                { assert process.out.png[0][1][1] ==~ /.*\/test_2_screen\.png/ }
            )
        }

    }

    test("sarscov2 single-end [fastq] stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = Channel.of([
                    [ id: 'test', single_end: true ],
                    [
                        file(params.test_data['sarscov2']['illumina'].test_1_fastq_gz, checkIfExists: true)
                    ]
                ])
                input[1] = file("${projectDir}/assets/fastq_screen_biowulf.conf", checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.txt[0][1] ==~ /.*\/test_1_screen\.txt/ },
                { assert process.out.png[0][1] ==~ /.*\/test_1_screen\.png/ }
            )
        }

    }

}
