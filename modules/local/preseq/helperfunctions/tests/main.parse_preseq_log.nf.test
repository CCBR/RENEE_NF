nextflow_process {

    name "Test Process PARSE_PRESEQ_LOG"
    script "modules/local/preseq/helperfunctions/main.nf"
    process "PARSE_PRESEQ_LOG"

    test("Single End Test") {

        when {
            params {
                // define parameters here. Example:
                // outdir = "tests/results"
            }
            process {
                """
                input[0] = Channel.of([
                    [ id: 'test', single_end:true ],
                    [ file("${projectDir}/tests/test_data/preseq/test.command.log", checkIfExists: true) ]
                ])
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
