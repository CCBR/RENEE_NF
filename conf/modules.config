process {
    withName: STAR_ALIGN_PASS1 {
        ext.args = [
            '--readFilesCommand zcat',
            '--outSAMtype BAM Unsorted',
            '--outFilterIntronMotifs RemoveNoncanonicalUnannotated',
            '--outSAMstrandField None',
            '--outFilterType BySJout',
            '--outFilterMultimapNmax 20',
            '--alignSJoverhangMin 8',
            '--alignSJDBoverhangMin 1',
            '--outFilterMismatchNmax 999',
            '--outFilterMismatchNoverLmax 0.3',
            '--alignIntronMin 20',
            '--alignIntronMax 1000000',
            '--alignMatesGapMax 1000000',
            '--alignEndsProtrude 10 ConcordantPair',
            '--peOverlapNbasesMin 10',
            '--sjdbOverhang 99',
            params.star_pass1_args ?: ''
        ].findAll { it?.trim() }.join(' ')
        ext.prefix = { "${meta.id}" }
    }

    withName: STAR_ALIGN_PASS2 {
        ext.args = [
            '--readFilesCommand zcat',
            '--limitSjdbInsertNsj 4000000',
            '--outSAMtype BAM Unsorted',
            '--outSAMstrandField None',
            '--outSAMunmapped Within',
            '--outWigType None',
            '--outWigStrand Stranded',
            '--outFilterType BySJout',
            '--outFilterMultimapNmax 20',
            '--outFilterMismatchNmax 999',
            '--outFilterMismatchNoverLmax 0.3',
            '--outFilterIntronMotifs RemoveNoncanonicalUnannotated',
            '--alignIntronMin 20',
            '--alignIntronMax 1000000',
            '--alignMatesGapMax 1000000',
            '--alignSJoverhangMin 8',
            '--alignSJDBoverhangMin 1',
            '--alignEndsProtrude 10 ConcordantPair',
            '--peOverlapNbasesMin 10',
            '--sjdbOverhang 100',
            '--quantMode TranscriptomeSAM GeneCounts',
            params.star_pass2_args ?: ''
        ].findAll { it?.trim() }.join(' ')
        ext.prefix = { "${meta.id}.p2" }
    }
    errorStrategy = 'finish'

    withName: /(FASTQSCREEN_FASTQSCREEN|FASTQ_SCREEN_1|FASTQ_SCREEN_2)/ {
        // Additional args to match snakemake
        ext.args = """--subset 1000000 \\
        --aligner bowtie2 \\
        --force"""
    }

    // STAR alignment step dedicated to Arriba fusion detection.
    // RENEE ran STAR inline and piped directly to arriba; in Nextflow the nf-core
    // ARRIBA_ARRIBA module takes a BAM, so a separate STAR run is required here.
    // Parameters are taken directly from the RENEE paired-end arriba rule.
    withName: 'STAR_ALIGN_ARRIBA' {
        ext.args = [
            '--readFilesCommand zcat',
            '--outSAMtype BAM Unsorted',
            '--outSAMunmapped Within',
            '--genomeLoad NoSharedMemory',
            '--outFilterMultimapNmax 50',     // Arriba-specific (vs 20 in STAR_ALIGN_PASS2)
            '--peOverlapNbasesMin 10',
            '--alignSplicedMateMapLminOverLmate 0.5',
            '--alignSJstitchMismatchNmax 5 -1 5 5',
            '--chimSegmentMin 10',
            '--chimOutType WithinBAM HardClip',
            '--chimJunctionOverhangMin 10',
            '--chimScoreDropMax 30',
            '--chimScoreJunctionNonGTAG 0',
            '--chimScoreSeparation 1',
            '--chimSegmentReadGapMax 3',
            '--chimMultimapNmax 50',
            '--twopassMode Basic',
            params.star_arriba_args ?: ''
        ].findAll { it?.trim() }.join(' ')
        ext.prefix = { "${meta.id}.arriba" }
    }

    // Arriba fusion calling.
    // RENEE only passed -b blacklist to the arriba binary; -d cytobands and
    // -p protein_domains were reserved for draw_fusions.R visualisation only.
    // The nf-core module passes cytobands and protein_domains to the arriba
    // binary as well (-d / -p), which is valid per Arriba docs and improves calls.
    // No extra ext.args are needed to match RENEE behaviour; the slot is kept
    // open for optional user overrides via params.arriba_args.
    withName: 'ARRIBA_ARRIBA' {
        ext.args   = { params.arriba_args ?: '' }
        ext.prefix = { "${meta.id}" }
    }

    // Sort the chimeric BAM produced by STAR_ALIGN_ARRIBA for use by ARRIBA_VISUALISATION.
    // Matches RENEE's inline `samtools sort` call in the arriba rule.
    withName: 'SAMTOOLS_SORT_ARRIBA' {
        ext.prefix = { "${meta.id}.arriba" }
    }

    // draw_fusions.R figure generation. Mirrors RENEE's draw_fusions.R call
    // that consumed the sorted chimeric BAM and the Arriba fusions TSV.
    withName: 'ARRIBA_VISUALISATION' {
        ext.args   = { params.arriba_visualisation_args ?: '' }
        ext.prefix = { "${meta.id}" }
    }
}
