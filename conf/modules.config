process {

    withName: 'DOWNLOAD_DATABASES:UNTAR_FASTQ_DB' {
        // FastQ Screen archives contain fastq_screen_db/<db_name>/; strip both levels
        // so only the index files land in the <db_name> prefix directory.
        // args2 is used (placed after the archive) to avoid -f consuming the flag.
        ext.args2 = '--strip-components 2'
    }

    withName: 'DOWNLOAD_DATABASES:UNTAR_KRAKEN_DB' {
        // Kraken2 archive has a single top-level dir; strip it so files land
        // directly in the prefix directory.
        ext.args2 = '--strip-components 1'
    }

    withName: 'MULTIQC' {
        ext.args = '--ignore "*/.singularity/*" --interactive'
    }

    withName: FUSION_ARRIBA {
        ext.args_STAR = null
        ext.args_arriba = null
        ext.prefix = { "${meta.id}.p2.arriba" }
    }

    withName: STAR_ALIGN_BASIC {
        ext.args = [
            '--readFilesCommand zcat',
            '--twopassMode Basic',
            '--limitSjdbInsertNsj 4000000',
            '--outSAMtype BAM SortedByCoordinate',
            '--outSAMstrandField None',
            '--outSAMunmapped Within',
            '--outWigType None',
            '--outWigStrand Stranded',
            '--outFilterType BySJout',
            '--outFilterMultimapNmax 20',
            '--outFilterMismatchNmax 999',
            '--outFilterMismatchNoverLmax 0.3',
            '--outFilterIntronMotifs RemoveNoncanonicalUnannotated',
            '--alignSJoverhangMin 8',
            '--alignSJDBoverhangMin 1',
            '--alignIntronMin 20',
            '--alignIntronMax 1000000',
            '--alignMatesGapMax 1000000',
            '--quantMode TranscriptomeSAM GeneCounts',
            params.star_pass2_args ?: ''
        ].findAll { it?.trim() }.join(' ')
        ext.prefix = { "${meta.id}.p2" }
    }

    withName: CUTADAPT {
        // RENEE's `trim_se` rule overrides MINLEN with 16 when --small-rna is used
        ext.min_length = params.small_rna ? 16 : 35
    }

    withName: STAR_ALIGN_SMALL {
        // Matches the `star_small` rule in RENEE (workflow/rules/single-end.smk),
        // which follows ENCODE's recommendations for small RNA sequencing.
        // --clip3pAdapterSeq is RENEE's ADAPTER1/ADAPTER2 pair ("-" and ""),
        // i.e. STAR's default of no 3' adapter clipping.
        // STAR writes an unsorted BAM which SAMTOOLS_SORT_SMALL then sorts,
        // because samtools uses less memory than --outSAMtype BAM SortedByCoordinate.
        ext.args = [
            '--outFilterMultimapNmax 20',
            '--alignSJDBoverhangMin 1000',
            '--outFilterScoreMinOverLread 0',
            '--outFilterMatchNminOverLread 0',
            '--outFilterMatchNmin 16',
            '--outFilterMismatchNoverLmax 0.3',
            '--alignIntronMax 1',
            '--clip3pAdapterSeq -',
            '--readFilesCommand zcat',
            '--outSAMunmapped Within',
            '--limitSjdbInsertNsj 4000000',
            '--quantMode TranscriptomeSAM GeneCounts',
            '--outSAMtype BAM Unsorted',
            params.star_pass2_args ?: ''
        ].findAll { it?.trim() }.join(' ')
        ext.prefix = { "${meta.id}.p2" }
    }

    withName: SAMTOOLS_SORT_SMALL {
        // Name the sorted BAM as STAR would, matching the RENEE `star_small` output.
        ext.prefix = { "${meta.id}.p2.Aligned.sortedByCoord.out" }
    }

    withName: STAR_ALIGN_PASS1 {
        ext.args = [
            '--readFilesCommand zcat',
            '--outSAMtype BAM Unsorted',
            '--outFilterIntronMotifs RemoveNoncanonicalUnannotated',
            '--outSAMstrandField None',
            '--outFilterType BySJout',
            '--outFilterMultimapNmax 20',
            '--alignSJoverhangMin 8',
            '--alignSJDBoverhangMin 1',
            '--outFilterMismatchNmax 999',
            '--outFilterMismatchNoverLmax 0.3',
            '--alignIntronMin 20',
            '--alignIntronMax 1000000',
            '--alignMatesGapMax 1000000',
            '--alignEndsProtrude 10 ConcordantPair',
            '--peOverlapNbasesMin 10',
            params.star_pass1_args ?: ''
        ].findAll { it?.trim() }.join(' ')
        ext.prefix = { "${meta.id}" }
    }

    withName: STAR_ALIGN_PASS2 {
        ext.args = [
            '--readFilesCommand zcat',
            '--limitSjdbInsertNsj 4000000',
            '--outSAMtype BAM SortedByCoordinate',
            '--outSAMstrandField None',
            '--outSAMunmapped Within',
            '--outWigType None',
            '--outWigStrand Stranded',
            '--outFilterType BySJout',
            '--outFilterMultimapNmax 20',
            '--outFilterMismatchNmax 999',
            '--outFilterMismatchNoverLmax 0.3',
            '--outFilterIntronMotifs RemoveNoncanonicalUnannotated',
            '--alignIntronMin 20',
            '--alignIntronMax 1000000',
            '--alignMatesGapMax 1000000',
            '--alignSJoverhangMin 8',
            '--alignSJDBoverhangMin 1',
            '--alignEndsProtrude 10 ConcordantPair',
            '--peOverlapNbasesMin 10',
            '--quantMode TranscriptomeSAM GeneCounts',
            params.star_pass2_args ?: ''
        ].findAll { it?.trim() }.join(' ')
        ext.prefix = { "${meta.id}.p2" }
    }
    errorStrategy = 'finish'

    withName: /(FASTQSCREEN_FASTQSCREEN|FASTQ_SCREEN_1|FASTQ_SCREEN_2)/ {
        // Additional args to match snakemake
        ext.args = """--subset 1000000 \\
        --aligner bowtie2 \\
        --force"""
    }


    withName: PICARD_ADDORREPLACEREADGROUPS {
        cpus = 6
        memory = 110.GB
        ext.args = [
            "--TMP_DIR .",
            "--RGID id",
            "--RGLB library",
            "--RGPL illumina",
            "--RGPU machine",
            "--RGSM sample",
            "--VALIDATION_STRINGENCY SILENT"
        ].findAll { it?.trim() }.join(" ")
        ext.prefix = { "${meta.id}.star_rg_added.sorted" }
        ext.suffix = "bam"
    }

    withName: PICARD_MARKDUPLICATES {
        cpus = 6
        memory = 110.GB
        ext.args = [
            "--TMP_DIR .",
            "--CREATE_INDEX true",
            "--VALIDATION_STRINGENCY SILENT"
        ].findAll { it?.trim() }.join(" ")
        ext.prefix = { "${meta.id}.star_rg_added.sorted.dmark" }
        // ext.suffix = "bam" This is probably unnecessary
    }

    withName: QUALIMAP_BAMQC {
        cpus   = 16
        memory = 80.GB
        ext.args   = ''
        ext.prefix = { "${meta.id}" }
    }

    withName: PICARD_COLLECTRNASEQMETRICS {
        cpus = 4
        memory = 110.GB
        ext.args = [
            "--TMP_DIR .",
            "--STRAND_SPECIFICITY ${params.picard_strand_specificity}",
            "--VALIDATION_STRINGENCY SILENT"
        ].findAll { it?.trim() }.join(" ")
        ext.prefix = { "${meta.id}" }
    }

    withName: RSEQC_INFEREXPERIMENT {
        ext.args = '-s 1000000'
        ext.prefix = { "${meta.id}.strand" }
    }

    withName: RSEQC_READDISTRIBUTION {
        ext.prefix = { "${meta.id}.Rdist" }
    }

    withName: RSEQC_INNERDISTANCE {
        ext.args = '-k 10000000'
        ext.prefix = { "${meta.id}" }
    }

    withName: RSEQC_TIN {
        // No ext.prefix override — defaults to ${meta.id}.
        // The module renames tin.py output from ${bam.baseName}.* to ${prefix}.*
        // Setting prefix == bam.baseName would cause a same-file mv error.
    }

    withName: RSEM_CALCULATEEXPRESSION {
        // Args matching RENEE Snakemake rsem rule exactly
        ext.args = [
            '--no-bam-output',
            '--calc-ci',
            '--seed 12345',
            '--time',
            '--keep-intermediate-files',
            '--estimate-rspd'
        ].findAll { it?.trim() }.join(' ')
        ext.prefix = { "${meta.id}.RSEM" }
    }

    withName: BAM2STRANDEDBW {
        cpus   = 8
        memory = 32.GB
    }

    withName: PRESEQ_CCURVE {
        // -B: treat input as BAM (matches snakemake: preseq c_curve -B)
        ext.args = '-B -verbose'
        ext.prefix = { "${meta.id}" }
    }

}
