// containers accessed in process definitions with $params.containers.NAME
params {
    containers {
        base         = 'nciccbr/ccbr_ubuntu_base_20.04:v6.1'
        rseqc        = 'nciccbr/ccbr_rseqc_4.0.0:v3'
        // Same images RENEE (classic)'s workflow/rules/build.smk uses for the
        // equivalent rules (config/containers/images.json: build_rnaseq, build_gtf).
        build_rnaseq = 'nciccbr/ccbr_build_rnaseq:v0.0.1'
        build_gtf    = 'nciccbr/ccbr_build_rnaseq:v2'
    }
}

process {
    withName: 'RSEQC_INFEREXPERIMENT'  { container = params.containers.rseqc }
    withName: 'RSEQC_READDISTRIBUTION' { container = params.containers.rseqc }
    withName: 'RSEQC_INNERDISTANCE'    { container = params.containers.rseqc }
    withName: 'RSEQC_TIN'             { container = params.containers.rseqc }
}
