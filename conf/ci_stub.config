params {
    config_profile_name = 'Test stubs'
    config_profile_description = 'Minimal test configuration to run stubs with continuous integration'

    input = 'assets/samplesheet.csv'

    max_cpus = 2        // for GitHub Actions https://docs.github.com/en/actions/using-github-hosted-runners/about-github-hosted-runners#supported-runners-and-hardware-resources
    max_memory = '6.GB'
    max_time   = '6.h'

    publish_dir_mode = "symlink"

    genome = 'hg38_stub'

    shared_resources = "${projectDir}/tests/test_data/shared_resources"
    fastq_screen_conf  = "${projectDir}/tests/test_data/shared_resources/fastq_screen_db/fastq_screen.conf"
    fastq_screen_conf2 = "${projectDir}/tests/test_data/shared_resources/fastq_screen_db/fastq_screen_2.conf"

    // --- for build mode (--build_shared_resources_only / --build) ---
    // UNTAR's stub still runs `tar -tf` against the real staged input to
    // fabricate a file listing, so point database_urls at small local tar
    // fixtures instead of the real https://hpc.nih.gov archives.
    database_urls = [
        hg19                       : "${projectDir}/tests/test_data/database_url_stubs/fastq_screen_db.hg19.tar",
        mm9                        : "${projectDir}/tests/test_data/database_url_stubs/fastq_screen_db.mm9.tar",
        Virus                      : "${projectDir}/tests/test_data/database_url_stubs/fastq_screen_db.Virus.tar",
        Bacteria                   : "${projectDir}/tests/test_data/database_url_stubs/fastq_screen_db.Bacteria.tar",
        Fungi                      : "${projectDir}/tests/test_data/database_url_stubs/fastq_screen_db.Fungi.tar",
        UniVec_vectors             : "${projectDir}/tests/test_data/database_url_stubs/fastq_screen_db.UniVec_vectors.tar",
        rRNA                       : "${projectDir}/tests/test_data/database_url_stubs/fastq_screen_db.rRNA.tar",
        '20180907_standard_kraken2': "${projectDir}/tests/test_data/database_url_stubs/20180907_standard_kraken2.tar"
    ]
}

process {
    cpus = 1
    memory = '1.GB'
}
