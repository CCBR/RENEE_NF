// CRAFT: Preserve legacy launcher controls using native Nextflow parameters.
def compatibility_limits = new LinkedHashMap(process.resourceLimits)

if (params.partition) {
    process.queue = params.partition
}
if (params.time) {
    def match = params.time.toString() =~ /^(?:(\d+)-)?(\d+):(\d+):(\d+)$/
    def walltime = match.matches()
        ? "${(match[0][1] ?: '0').toInteger() * 86400 + match[0][2].toInteger() * 3600 + match[0][3].toInteger() * 60 + match[0][4].toInteger()} s"
        : params.time
    process.time = walltime
    if (nextflow.util.Duration.of(walltime) < nextflow.util.Duration.of(compatibility_limits.time)) {
        compatibility_limits.time = walltime
    }
}
if (params.max_jobs) {
    executor.queueSize = params.max_jobs
    executor.'$slurm'.queueSize = params.max_jobs
}
if (params.threads) {
    executor.'$local'.cpus = params.threads
    if (process.executor == 'local') {
        compatibility_limits.cpus = Math.min(params.threads as int, compatibility_limits.cpus as int)
    }
}
if (params.tmp_dir) {
    process.scratch = params.tmp_dir
}
if (params.sif_cache) {
    singularity.cacheDir = params.sif_cache
    apptainer.cacheDir = params.sif_cache
}
process.resourceLimits = compatibility_limits
